[Unit]
Description=Markdown Content Editor Web App
After=network.target

[Service]
Type=simple
User=markdown-content-editor
Group=markdown-content-editor
WorkingDirectory=/opt/markdown-content-editor
EnvironmentFile=/etc/markdown-content-editor.env
ExecStart=/usr/bin/node /opt/markdown-content-editor/dist/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/content

[Install]
WantedBy=multi-user.target
