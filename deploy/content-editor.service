[Unit]
Description=Content Editor Web App
After=network.target

[Service]
Type=simple
User=content-editor
Group=content-editor
WorkingDirectory=/opt/content-editor
EnvironmentFile=/etc/content-editor.env
ExecStart=/usr/bin/node /opt/content-editor/dist/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/content

[Install]
WantedBy=multi-user.target
