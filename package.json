{
  "name": "content-editor",
  "version": "1.0.0",
  "description": "A lightweight browser-based Markdown editor for reviewing local content files.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:env": "node --env-file=.env dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "vitest": "^3.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0"
  }
}
